{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glass Table Spike",
  "version": "0.0.0",
  "identifier": "dev.nat20.glass-table-spike",
  "build": {
    "frontendDist": "page"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ws://127.0.0.1:*; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png"],
    "externalBin": ["binaries/glass-table-host", "binaries/nat20-api-server"],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    }
  }
}
