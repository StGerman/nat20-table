            "text": "A tree lies across the road. A farmer leans on his gate: for a few coppers each, the wagon can cross his field.",
            "owner_pick": "clear",
            "choices": [
                {
                    "id": "clear",
                    "text": "Drag the tree aside.",
                    "effects": [
                        {"do": "remember", "deed": "cleared_the_tree"},
