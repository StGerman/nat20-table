            "choices": [
                {"id": "pass", "text": "Pass it by.", "keeps": ["road_keeps_its_own"]},
                {"id": "search", "text": "Look through it.", "breaks": ["road_keeps_its_own"], "unless": "scouted", "effects": [{"do": "delay", "minutes": 15}]},
                {"id": "ruts", "text": "Follow the wheel ruts back to where it left the trail.", "if": "scouted"}
