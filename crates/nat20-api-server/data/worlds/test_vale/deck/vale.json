                            "do": "check", "who": "blades", "ability": "strength", "skill": "athletics", "dc": 10,
                            "success": [{"do": "delay", "minutes": 30}],
                            "failure": [{"do": "delay", "minutes": 90}]
                        }
                    ]
                },
                {
                    "id": "around",
                    "text": "Pay the farmer and go round.",
                    "effects": [
                        {"do": "pay", "who": "party", "copper": 10},
                        {"do": "delay", "minutes": 20}
                    ]
                }
            ]
        },
        {
            "id": "yard_wolves",
            "zone": "crossing_inn",
            "when": "night",
            "target": "blades",
            "text": "Wolves howl beyond the inn's yard wall, closer each time.",
            "choices": [
                {
                    "id": "watch",
                    "text": "Keep a sharp watch.",
                    "effects": [
                        {
                            "do": "check", "who": "blades", "ability": "wisdom", "skill": "perception", "dc": 10,
                            "failure": [{"do": "cargo", "good": "rations", "change": -1}]
                        }
                    ]
                },
                {
                    "id": "drive_off",
                    "text": "Go out and drive them off.",
                    "effects": [{"do": "fight", "monsters": ["wolf"]}]
                },
                {
                    "id": "tree_fire",
                    "if": "cleared_the_tree",
                    "text": "Burn the branches of the tree you dragged aside, all night.",
                    "effects": [{"do": "remember", "deed": "kept_the_fire"}]
                }
            ]
        },
        {
            "id": "hill_goats",
            "zone": "vale_hills",
            "target": "blades",
            "unless": "cleared_the_tree",
            "text": "Goats watch the wagon from the rocks above the trail.",
            "choices": [
                {"id": "wave", "text": "Wave to them."},
                {"id": "shoo", "text": "Throw a stone to clear them off the trail.", "effects": [{"do": "delay", "minutes": 15}]}
            ]
        },
        {
            "id": "shepherd_boy",
            "zone": "vale_hills",
            "target": "blades",
            "unless": "cleared_the_tree",
            "text": "A shepherd boy sits on a stone and asks where the wagon is going.",
            "scout": "perception",
            "choices": [
                {"id": "tell", "text": "Tell him."},
                {"id": "walk_on", "text": "Walk on without a word.", "unless": "scouted", "effects": [{"do": "delay", "minutes": 15}]},
                {"id": "hail", "text": "Call to him from the ridge before he calls to you.", "if": "scouted"}
            ]
        },
        {
            "id": "cairn",
            "zone": "vale_hills",
            "target": "blades",
            "unless": "cleared_the_tree",
