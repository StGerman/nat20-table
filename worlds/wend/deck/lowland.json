        {
            "id": "drovers",
            "zone": "lowland",
            "when": "night",
            "target": "caravan",
            "text": "Two drovers ask to share the fire. They are friendly, and they look over the wagon a little too long.",
            "owner_pick": "welcome",
            "choices": [
                {
                    "id": "welcome",
                    "text": "Make room for them at the fire.",
                    "effects": [
                        {
                            "do": "check",
                            "who": "blades",
                            "ability": "wisdom",
                            "skill": "insight",
                            "dc": 15,
                            "failure": [
                                {"do": "add_card", "card": "missing_sack", "soon": true}
                            ]
                        }
                    ],
                    "unless": "fed_gwyns_dog"
