{
    "_comment": "Road cards for the Wend valley floor (MAP-6, API-43): the river road between Wendford and Wendmouth and the mill lane. Our own text, CC-BY-4.0, credit 'nat20-table contributors'. Variant rule (D2): the road event deck is ours, not the SRD's. Checks use the SRD DC ladder; fights use SRD 5.2.1 stat blocks. Text the players read never names a DC, a number of hit points or a stat block.",
    "cards": [
        {
            "id": "rutted_road",
            "zone": "lowland",
            "target": "caravan",
            "text": "Last week's rain has turned the river road to soup. The wagon lurches, a wheel sinks to the hub, and the near horse refuses to pull.",
            "owner_pick": "unload",
            "choices": [
                {
                    "id": "push",
                    "text": "Put your shoulders to the wheel and heave.",
                    "effects": [
                        {
                            "do": "check", "who": "blades", "ability": "strength", "skill": "athletics", "dc": 10,
                            "success": [{"do": "delay", "minutes": 20}],
                            "failure": [{"do": "delay", "minutes": 90}]
                        }
                    ]
                },
                {
                    "id": "unload",
                    "text": "Unload the heaviest sacks, roll the wagon free, and load them again.",
                    "owner_insists": true,
                    "effects": [{"do": "delay", "minutes": 60}]
                }
            ]
        },
        {
            "id": "toll_bridge",
            "zone": "lowland",
            "target": "caravan",
            "text": "At the little bridge over the Millbeck a man in a borrowed helmet says the reeve's toll is two silver a head, and holds out his cap.",
            "owner_pick": "pay",
            "choices": [
                {
                    "id": "pay",
                    "text": "Pay him and cross.",
                    "effects": [{"do": "pay", "who": "party", "copper": 20}]
                },
                {
                    "id": "argue",
                    "text": "Tell him the reeve charges no such toll.",
                    "effects": [
                        {
                            "do": "check", "who": "blades", "ability": "charisma", "skill": "persuasion", "dc": 15,
                            "failure": [{"do": "pay", "who": "party", "copper": 20}]
                        }
                    ]
                },
                {
                    "id": "ford",
                    "text": "Go upstream and ford the beck.",
                    "effects": [
                        {"do": "delay", "minutes": 90},
                        {
                            "do": "check", "who": "blades", "ability": "strength", "skill": "athletics", "dc": 10,
                            "failure": [{"do": "cargo", "good": "rations", "change": -2}]
                        }
                    ]
                }
            ]
        },
        {
            "id": "peddler",
            "zone": "lowland",
            "target": "blades",
            "text": "A peddler pushing a handcart falls in beside the escort. He has news from up and down the road, he says, and he has not eaten since yesterday.",
            "choices": [
                {
                    "id": "share",
                    "text": "Share your food and listen.",
                    "effects": [
                        {"do": "cargo", "good": "rations", "change": -1},
                        {"do": "add_card", "card": "peddler_warning"}
                    ]
                },
                {
                    "id": "send_off",
                    "text": "Send him on his way."
                }
            ]
        },
        {
            "id": "peddler_warning",
            "zone": "lowland",
            "target": "blades",
            "chained": true,
            "once": true,
            "text": "The peddler you fed catches you up at a bend, out of breath: two men with cudgels are waiting in the willows ahead.",
            "choices": [
                {
                    "id": "go_ready",
                    "text": "Walk on with weapons drawn.",
                    "effects": [{"do": "fight", "monsters": ["bandit", "bandit"]}]
                },
                {
                    "id": "slip_past",
                    "text": "Lead the wagon quietly through the water meadow.",
                    "effects": [
                        {
                            "do": "check", "who": "blades", "ability": "dexterity", "skill": "stealth", "dc": 15,
                            "success": [{"do": "delay", "minutes": 40}],
                            "failure": [{"do": "fight", "monsters": ["bandit", "bandit"]}]
                        }
                    ]
                }
            ]
        },
        {
            "id": "stray_dog",
            "zone": "lowland",
            "target": "blades",
            "text": "A lean sheepdog trots out of a hedge and falls in beside the wagon, as if it had been hired too.",
            "choices": [
                {
                    "id": "feed",
                    "text": "Toss it a crust and let it come along.",
                    "effects": [{"do": "cargo", "good": "rations", "change": -1}]
                },
                {
                    "id": "shoo",
                    "text": "Send it home."
                }
            ]
        },
        {
            "id": "river_mist",
            "zone": "lowland",
            "when": "night",
            "target": "blades",
            "text": "Mist climbs off the river after dark and the fire spits. Something is moving near the wagon, or nothing is.",
            "choices": [
                {
                    "id": "watch",
                    "text": "Keep a sharp watch by the wagon.",
                    "effects": [
                        {
                            "do": "check", "who": "blades", "ability": "wisdom", "skill": "perception", "dc": 10,
                            "failure": [{"do": "cargo", "good": "rations", "change": -2}]
                        }
                    ]
                },
                {
                    "id": "sleep",
                    "text": "It's only mist. Sleep.",
                    "effects": [{"do": "cargo", "good": "rations", "change": -2}]
                }
            ]
        },
        {
            "id": "night_wolves",
            "zone": "lowland",
            "when": "night",
            "target": "blades",
            "text": "Wolves howl out on the water meadows, closer each time, and the horses stamp and pull at their ropes.",
            "choices": [
                {
                    "id": "stand",
                    "text": "Stand between the wolves and the horses.",
                    "effects": [{"do": "fight", "monsters": ["wolf", "wolf"]}]
                },
                {
                    "id": "build_fire",
                    "text": "Build the fire high and wait for dawn.",
                    "effects": [
                        {
                            "do": "check", "who": "blades", "ability": "wisdom", "skill": "survival", "dc": 10,
                            "failure": [{"do": "fight", "monsters": ["wolf"]}]
                        }
                    ]
                }
            ]
        },
        {
            "id": "drovers",
            "zone": "lowland",
            "when": "night",
            "target": "caravan",
            "text": "Two drovers ask to share the fire. They are friendly, and they look over the wagon a little too long.",
            "owner_pick": "welcome",
            "choices": [
                {
                    "id": "welcome",
                    "text": "Make room for them at the fire.",
                    "effects": [
                        {
                            "do": "check", "who": "blades", "ability": "wisdom", "skill": "insight", "dc": 15,
                            "failure": [{"do": "cargo", "good": "rations", "change": -2}]
                        }
                    ]
                },
                {
                    "id": "send_away",
                    "text": "Tell them to find their own fire."
                }
            ]
        }
    ]
}
