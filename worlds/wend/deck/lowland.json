                            "ability": "wisdom",
                            "skill": "survival",
                            "dc": 15,
                            "success": [
                                {"do": "remember", "deed": "tracked_the_sack"}
                            ],
                            "failure": [
                                {"do": "cargo", "good": "wheat", "change": -50}
                            ]
