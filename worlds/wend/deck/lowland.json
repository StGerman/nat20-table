        {
            "id": "bel_asks",
            "zone": "lowland",
            "when": "night",
            "target": "blades",
            "chained": true,
            "once": true,
            "text": "After dark the painted roadfolk cart rattles up to the fire. Bel, the woman from the Highsteads fire, does not sit down. She asks whether anyone has seen her boy.",
            "note": "Bel Corrin, and Tam, who is either on the wagon or hiding behind it. A word is kept: letting Tam answer means Bel lets him go to the fair if the human's character promises to look after him, and that promise is a deed later cards test. Covered for and found out, Bel tells every roadfolk fire in the valley. Maren is for the truth; Ilsa says the boy has rights too.",
            "choices": [
                {
                    "id": "truth",
                    "text": "Tell her the truth.",
                    "effects": [
                        {"do": "remember", "deed": "told_bel_the_truth"}
                    ]
                },
                {
                    "id": "cover",
                    "text": "Cover for him.",
                    "effects": [
                        {
                            "do": "check",
                            "who": "blades",
                            "ability": "charisma",
                            "skill": "deception",
                            "dc": 15,
                            "success": [
                                {"do": "remember", "deed": "covered_for_tam"}
                            ],
                            "failure": [
                                {"do": "remember", "deed": "lied_to_bel"}
                            ]
                        }
                    ]
                },
                {
                    "id": "let_tam",
                    "text": "Let Tam answer for himself.",
                    "keeps": [
                        "word_kept"
                    ],
                    "effects": [
                        {"do": "remember", "deed": "promised_bel"}
                    ]
                }
            ]
        },
        {
            "id": "old_company",
            "zone": "lowland",
            "when": "night",
            "target": "blades",
            "chained": true,
            "once": true,
            "text": "The peddler with the shaking hands catches up with the camp after dark and sees the grey lantern stitched on a Blade's sleeve, the sign of their old company. He goes quiet, then asks whether any of the company are still alive.",
            "note": "Tobin carried a battle-mage's books in the lord's border war, the war the Grey Lanterns fought in. Told about the company and its dead, he laughs and cries in one breath and remembers a red-scaled girl with a notebook (Ilsa's hook). Read well, his hands: he froze at a breach and a fire spell went wrong; read badly, a cheerful lie. Whatever they choose, from now on he tells every alehouse the Grey Lanterns are the last honest company in the kingdom.",
            "choices": [
                {
                    "id": "tell",
                    "text": "Tell him about the company.",
                    "effects": [
                        {"do": "remember", "deed": "told_tobin_of_the_dead"}
                    ]
                },
                {
                    "id": "hands",
                    "text": "Ask what happened to his hands.",
                    "effects": [
                        {
                            "do": "check",
                            "who": "blades",
                            "ability": "wisdom",
                            "skill": "insight",
                            "dc": 10,
                            "success": [
                                {"do": "remember", "deed": "knew_tobins_breach"}
                            ],
                            "failure": [
                                {"do": "remember", "deed": "heard_tobins_lie"}
                            ]
                        }
                    ]
                },
                {
                    "id": "change",
                    "text": "Change the subject.",
                    "effects": [
                        {"do": "remember", "deed": "kept_the_war_from_tobin"}
                    ]
                }
            ]
        },
        {
            "id": "what_agna_drew",
            "zone": "lowland",
            "target": "blades",
            "chained": true,
            "once": true,
            "text": "The silent pilgrim stops the Blades with a raised hand and draws in the mud with her staff: a bridge, a man in a helmet too big for him holding a notched stick, a second man with a cudgel, and a coin passing from a man in a very good coat to both of them.",
            "note": "Sister Agna, who cannot say it. If asked, the DM says what the drawing shows and nothing more: the notched stick is Col's tally, the coat is Rufus's. Read well, the Blades know who set the toll men on the bridge, and Rufus wants his due and Odda's mark can use it. The silent witness and the loud one, Tobin, reach the same truth by different roads.",
            "choices": [
                {
                    "id": "puzzle",
                    "text": "Puzzle out the drawing.",
                    "effects": [
                        {
                            "do": "check",
                            "who": "blades",
                            "ability": "intelligence",
                            "skill": "investigation",
                            "dc": 10,
                            "success": [
                                {"do": "remember", "deed": "knew_who_set_the_toll"}
                            ],
                            "failure": [
                                {"do": "remember", "deed": "agna_rubbed_it_out"}
                            ]
                        }
                    ]
                },
                {
                    "id": "thank",
                    "text": "Thank her and walk on.",
                    "effects": [
                        {"do": "remember", "deed": "thanked_agna"}
                    ]
                }
            ]
        },
        {
            "id": "peddlers_mark",
            "zone": "lowland",
            "target": "blades",
            "chained": true,
            "once": true,
            "if": "fed_tobin",
            "text": "The peddler with the shaking hands catches up while the Blades are still getting their breath back. He saw it all from the bend, he says, and the man in the sheepskin swung first.",
            "note": "Tobin, the valley's loudest carrier. A written account he marks with a cross and a drawing of his cart is what Osric or Brannock will believe without a check. Ilsa will offer to write it; let her. The weight of the dead is Rufus's and the chest's, never the Blades', and no choice here blames them.",
            "choices": [
                {
                    "id": "mark",
                    "text": "Ask him to put his mark on a written account.",
                    "effects": [
                        {"do": "remember", "deed": "peddler_testified"}
                    ]
                },
                {
                    "id": "warden",
                    "text": "Ask him to tell the warden at Saltmouth what he saw.",
                    "effects": [
                        {"do": "remember", "deed": "tobin_told_the_warden"}
                    ]
                },
                {
                    "id": "let_go",
                    "text": "Let him go his way.",
                    "effects": [
                        {"do": "remember", "deed": "let_tobin_go"}
                    ]
                }
            ]
        }
    ]
