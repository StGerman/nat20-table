{
  "name": "nat20-table",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "game"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "gen": "node tools/codegen/gen.mjs",
    "check:contract": "node tools/codegen/gen.mjs && git diff --exit-code -- generated packages/engine-client/src/generated && node tools/codegen/check-breaking.mjs --base origin/main",
    "check:ts": "tsc -p packages/engine-client && tsc -p game && node --experimental-strip-types --no-warnings --test packages/engine-client/test/*.test.ts game/test/*.test.ts",
    "spike": "node --experimental-strip-types --no-warnings game/spike/spike.ts",
    "spike:record": "node --experimental-strip-types --no-warnings game/spike/record.ts",
    "preflight": "node --experimental-strip-types --no-warnings game/src/play/preflight.ts",
    "pack:check": "node --experimental-strip-types --no-warnings game/src/pack/cli.ts check",
    "pack:schema": "node --experimental-strip-types --no-warnings game/src/pack/cli.ts schema",
    "play:ai-party": "node --experimental-strip-types --no-warnings game/src/play/ai-party.ts",
    "play:scene": "node --experimental-strip-types --no-warnings game/src/play/scene.ts",
    "play:exit": "node --experimental-strip-types --no-warnings game/src/play/scene.ts --scenes s1_village_green,s3_mill_yard --seat ink",
    "play:full": "node --experimental-strip-types --no-warnings game/src/play/full.ts",
    "play:cheap": "node --experimental-strip-types --no-warnings game/src/play/full.ts --profile cheap",
    "play:demo": "node --experimental-strip-types --no-warnings game/src/play/full.ts --profile demo",
    "audit:narration": "node --experimental-strip-types --no-warnings game/src/check/cli.ts",
    "runs:verdict": "node --experimental-strip-types --no-warnings game/src/play/runs.ts verdict",
    "runs:finish": "node --experimental-strip-types --no-warnings game/src/play/runs.ts finish",
    "runs:upload": "node --experimental-strip-types --no-warnings game/src/play/runs.ts upload"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "7.0.2"
  }
}
